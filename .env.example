###############################################################################
# QuantPulse environment template
#
# Copy to .env.local for local development:   cp .env.example .env.local
# .env.local is gitignored. NEVER commit real secrets.
#
# On Vercel, add these under Project -> Settings -> Environment Variables and
# pick the right scope (Production / Preview / Development).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time and are
# publicly readable. Anything secret must NOT carry that prefix.
###############################################################################

# --- Application -------------------------------------------------------------
# Canonical origin, no trailing slash. Also used as the CORS allow-list entry.
# Local:      http://localhost:3000
# Production: https://quantpulse.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional extra browser origins allowed to call the API, comma separated.
# CORS_ALLOWED_ORIGINS=https://www.quantpulse.io,https://staging.quantpulse.io


# --- Webhook signing ---------------------------------------------------------
# HMAC-SHA256 secret used to verify inbound webhook payloads.
# LEAVE EMPTY to disable signature checking (fine locally, NOT for production).
# Generate:  openssl rand -hex 32
QP_WEBHOOK_SECRET=


# --- Market data providers ---------------------------------------------------
# The app currently runs on a deterministic simulated series and does not read
# these yet. They are here for when you swap in a live feed.
# Alpha Vantage:            https://www.alphavantage.co/support/#api-key
# Financial Modeling Prep:  https://site.financialmodelingprep.com/developer/docs
FINANCIAL_API_KEY=
FINANCIAL_API_PROVIDER=alphavantage


# --- Broker: Alpaca (paper trading) ------------------------------------------
# https://app.alpaca.markets/paper/dashboard/overview
# Server-side only. These can place orders — never expose them to the client.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets


# --- Billing: Stripe ---------------------------------------------------------
# https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ outside production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or the dashboard webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Price IDs backing the Basic ($19) and Pro ($49) tiers.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
